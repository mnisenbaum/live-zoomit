<Window x:Class="LiveZoomIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveZoomIt"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Grid>
        <!-- Quadro branco / negro (W / K). Fica atrás dos traços. -->
        <Rectangle x:Name="Board" Visibility="Collapsed" IsHitTestVisible="False" />

        <!-- Superfície de desenho. No modo passivo fica sem fundo e sem edição. -->
        <InkCanvas x:Name="Ink" Background="Transparent" EditingMode="None" />

        <!-- Anéis do destaque de cliques (Ctrl+4). -->
        <Canvas x:Name="EffectsLayer" IsHitTestVisible="False" />

        <!-- Área do monitor primário (posicionada em código), usada para a dica e os avisos. -->
        <Grid x:Name="PrimaryArea" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">
                <Border x:Name="Hint" Visibility="Collapsed" Padding="14,8" CornerRadius="8" Background="#D01E1E1E">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ColorSwatch" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Fill="Red" Stroke="White" StrokeThickness="1" />
                        <TextBlock x:Name="ToolText" MinWidth="130" VerticalAlignment="Center"
                                   Foreground="White" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" />
                        <Rectangle Width="1" Margin="12,2" Fill="#60FFFFFF" />
                        <StackPanel VerticalAlignment="Center">
                            <!-- Preenchido em código com as teclas de cor configuradas. -->
                            <TextBlock x:Name="ColorKeysHint" Foreground="#E0FFFFFF" FontFamily="Segoe UI" FontSize="12" />
                            <TextBlock Foreground="#E0FFFFFF" FontFamily="Segoe UI" FontSize="12"
                                       Text="Arrastar com Ctrl retângulo · Shift linha · Alt elipse · Ctrl+Shift seta  ·  Botão direito apaga  ·  E limpar tudo" />
                            <TextBlock Foreground="#E0FFFFFF" FontFamily="Segoe UI" FontSize="12"
                                       Text="Ctrl+Z / Ctrl+Y desfazer / refazer  ·  Ctrl+C copiar · Ctrl+S salvar  ·  Esc sair" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="Toast" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,6" CornerRadius="6"
                        HorizontalAlignment="Center" Background="#E0202A3A">
                    <TextBlock x:Name="ToastText" Foreground="White" FontFamily="Segoe UI" FontSize="13" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
